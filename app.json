{
  "expo": {
    "name": "AsliLearn AI",
    "slug": "aslilearn-mobile",
    "version": "1.0.65",
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#e6f7fe"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tech.aslilearnai",
      "buildNumber": "65"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-foreground.png",
        "backgroundColor": "#041F46"
      },
      "package": "com.tech.aslilearnai",
      "versionCode": 65,
      "edgeToEdgeEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#f0fdf4"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#e6f7fe"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "aslilearn",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf6ca368-dae2-4047-a1c5-839bd8db3565"
      }
    },
    "owner": "aslilearnai1819"
  }
}
