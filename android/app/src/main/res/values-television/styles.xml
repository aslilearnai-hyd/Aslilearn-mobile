<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">#e6f7fe</item>
    <item name="android:windowBackground">@color/splashscreen_background</item>
  </style>
  <!-- Avoid Android 12 SplashScreen APIs on TV — they close the activity on many OEM panels. -->
  <style name="Theme.App.SplashScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/splashscreen_background</item>
    <item name="android:statusBarColor">#e6f7fe</item>
  </style>
</resources>
